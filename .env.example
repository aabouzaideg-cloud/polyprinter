# ── Capital.com Credentials ──────────────────────────────────────────────────
CAPITAL_API_KEY=your_capital_api_key_here
CAPITAL_EMAIL=your@email.com
CAPITAL_PASSWORD=your_password_here

# MODE: "DEMO" or "LIVE"  — ALWAYS start with DEMO
CAPITAL_MODE=DEMO

# ── Polymarket CLOB API ───────────────────────────────────────────────────────
# Public API — no key required, but add one if you have a private endpoint
POLYMARKET_API_KEY=

# Comma-separated list of whale wallet addresses to monitor
WHALE_WALLETS=0xWALLET1,0xWALLET2,0xWALLET3

# ── News API (NewsAPI.org — free tier: 100 req/day) ───────────────────────────
NEWS_API_KEY=your_newsapi_key_here

# ── Bot Behaviour ─────────────────────────────────────────────────────────────
# Minimum implied-probability shift (%) to trigger an Analysis Event
WHALE_TRIGGER_THRESHOLD=3.0

# Maximum risk per trade as % of account balance
MAX_RISK_PER_TRADE_PCT=2.0

# Daily drawdown circuit-breaker (%)
MAX_DAILY_DRAWDOWN_PCT=5.0

# Maximum spread tolerance (% of asset mid-price)
MAX_SPREAD_PCT=0.1

# Polling interval in seconds
POLL_INTERVAL_SECONDS=30

# Minimum confidence score (0-100) required before placing a trade
MIN_CONFIDENCE_SCORE=60
